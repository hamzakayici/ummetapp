# Ümmet mobil — ortam değişkenleri
# Kopyala: cp .env.example .env.local

# ── RevenueCat SDK (mobil uygulama) ──
# RevenueCat → Project → API keys → SDK API keys
# Test Store: tek test_ anahtarı iOS + Android için aynı kullanılır.
# Canlıda: ayrı appl_ (iOS) ve goog_ (Android) anahtarları gelir.

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# İsterseniz tek satırda (Test Store):
# EXPO_PUBLIC_REVENUECAT_API_KEY=test_...
