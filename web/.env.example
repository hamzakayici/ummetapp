# ─────────────────────────────────────────────────────────────
# Ümmet — üretim ortamı örneği (cPanel)
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env ASLA public_html içinde veya git'te olmamalı.
# ─────────────────────────────────────────────────────────────

APP_NAME="Ümmet"
APP_ENV=production
APP_KEY=                        # php artisan key:generate ile üretin
APP_DEBUG=false
APP_URL=https://ummetapp.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Veritabanı (cPanel MySQL) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kullanici_ummet
DB_USERNAME=kullanici_ummet
DB_PASSWORD=

# Paylaşımlı hostingde Redis yok — veritabanı sürücüleri kullanılır
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── E-posta (cPanel SMTP) ──
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="destek@ummetapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Push bildirimleri ──
# ⚠️ Üretimde true. Yerelde MUTLAKA false — yoksa gerçek kullanıcılara bildirim gider.
PUSH_ENABLED=true
PUSH_TEST_TOKENS=

# ── Mobil API ──
API_INGEST_ENABLED=true

# ── RevenueCat ──
# Webhook (admin panelde anlık gelir verisi):
#   RevenueCat → Integrations → Webhooks
#   URL: https://ummetapp.com/api/v1/webhooks/revenuecat
#   Authorization: aşağıdaki REVENUECAT_WEBHOOK_SECRET ile birebir aynı (sk_ değil — siz belirlersiniz)
REVENUECAT_WEBHOOK_SECRET=

# Secret API key (sk_...) — sunucu REST API; webhook ile karıştırmayın
REVENUECAT_SECRET_API_KEY=

# ── App Store Connect (günlük, 1-2 gün gecikmeli) ──
# .p8 dosyasını public_html DIŞINA koyun, chmod 600
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_P8_PATH=/home/kullanici/gizli/AuthKey_XXXXXXXXXX.p8
ASC_APP_ID=6760871547

# ── Google Play Console (yayın sonrası) ──
PLAY_PACKAGE_NAME=com.ummet.app
PLAY_SERVICE_ACCOUNT_PATH=
PLAY_REPORT_BUCKET=

# Play Store yayınlanınca doldurun — tüm mağaza butonları otomatik ikili olur
PLAY_STORE_URL=
